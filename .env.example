# ─────────────────────────────────────────
# REQUIRED — fill these in before deploying
# ─────────────────────────────────────────

# Google Maps Places API
# Get it: console.cloud.google.com → APIs & Services → Credentials
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Twilio (for WhatsApp sending)
# Get it: console.twilio.com
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Your WhatsApp number (receives generated messages for approval)
YOUR_WHATSAPP=whatsapp:+6591234567

# Telegram bot (for lead notifications)
# Get it: message @BotFather on Telegram → /newbot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# Anthropic (for AI outreach generation)
# Already set in Claude artifacts — add your own key here for backend use
ANTHROPIC_API_KEY=your_anthropic_api_key

# Server
PORT=3000
NODE_ENV=production

# ─────────────────────────────────────────
# OPTIONAL — tweak as needed
# ─────────────────────────────────────────

# How often to scrape for new leads (cron syntax)
# Default: every day at 8am Singapore time
SCRAPE_CRON=0 8 * * *

# Min score for a lead to be considered qualified (0-100)
QUALIFY_THRESHOLD=60
